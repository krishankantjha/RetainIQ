# RetainIQ — copy to .env and edit (do not commit .env)

# Backend
APP_NAME=RetainIQ API
APP_ENV=development
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./customer_retention.db

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$w5uwmvOZ7LEYex5dC7L3/uzqj0jXnSsOJuwwj3zAXWDjE5jRi8LUG
ALLOW_USER_REGISTRATION=false

MAX_UPLOAD_SIZE_MB=25

# Comma-separated browser origins (no spaces). Add your live site when deploying.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Frontend (VITE_* only — exposed to the browser)
VITE_API_BASE_URL=
# VITE_GUEST_USERNAME=admin
# VITE_GUEST_PASSWORD=password

# Docker (run from docker/ with --env-file ../.env)
BACKEND_PORT=8000
FRONTEND_PORT=8080
NGINX_PORT=80
