# ==============================================================================
# RetainIQ — Local / Docker environment (SQLite + single admin)
# ==============================================================================
# Copy to `.env` in the project root for Docker Compose overrides.

# --- Application ---
APP_ENV=development
ALLOW_USER_REGISTRATION=false

# SQLite (default). Cohort data persists in the Docker volume `retainiq_sqlite`.
# DATABASE_URL=sqlite:///./data/customer_retention.db

# Admin login: username `admin` (override with ADMIN_USERNAME in backend/.env)
# Default dev password is `password` when ADMIN_PASSWORD_HASH is unset in development.
# Generate a hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
JWT_SECRET=
ADMIN_PASSWORD_HASH=

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

BACKEND_PORT=8000
FRONTEND_PORT=8080
NGINX_PORT=80
