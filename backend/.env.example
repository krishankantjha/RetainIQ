# Core API Configurations
APP_NAME="RetainIQ API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"

# Security & Authentication
# Generate a secure JWT secret for any non-local deployment.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin credentials (bcrypt hash — NOT the plain password)
# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# Dev-only example hash below is for password "password" — replace before any shared deployment.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$12$w5uwmvOZ7LEYex5dC7L3/uzqj0jXnSsOJuwwj3zAXWDjE5jRi8LUG"

# Set to false in production unless you explicitly need open registration.
ALLOW_USER_REGISTRATION=true

# Maximum CSV upload size in megabytes
MAX_UPLOAD_SIZE_MB=25

# Database Persistence
