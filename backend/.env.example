# Core API Configurations
APP_NAME="RetainIQ API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost"

# Security & Authentication
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Single admin account (public sign-up disabled by default)
ADMIN_USERNAME="admin"
# Dev hash for password "password" — replace before any shared deployment.
ADMIN_PASSWORD_HASH="$2b$12$w5uwmvOZ7LEYex5dC7L3/uzqj0jXnSsOJuwwj3zAXWDjE5jRi8LUG"
ALLOW_USER_REGISTRATION=false

MAX_UPLOAD_SIZE_MB=25

# SQLite — subscriber cohorts and prediction results
DATABASE_URL="sqlite:///./customer_retention.db"
